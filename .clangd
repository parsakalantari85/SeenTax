# clangd can't read .vcxproj files, so the compiler settings it needs are repeated here.
CompileFlags:
  Add: [-std=c++20, -DUNICODE, -D_UNICODE] # the projects' "Character Set: Unicode"
Diagnostics:
  Includes:
    # pch.h: MSVC precompiled headers must be included first even when nothing in them is used.
    # WindowsHeaders.h: wraps <windows.h>, whose functions clangd credits to sub-headers like
    # <winuser.h> that can't be included on their own, so it would always look "unused".
    IgnoreHeader: [pch\.h, WindowsHeaders\.h]
---
# Engine's include folders (mirrors Engine.vcxproj). Update the ONNX Runtime path when the
# NuGet package version changes.
If:
  PathMatch: Engine/.*
CompileFlags:
  Add:
    - -I../Shared
    - -I../packages/Microsoft.ML.OnnxRuntime.1.30.0/build/native/include
---
# The Control Panel (the WinUI project at the root): XAML and C++/WinRT headers generated by the
# build, Shared (for the Engine messages), and WIL. Update the WIL path when its NuGet package version changes.
If:
  PathMatch: '[^/]*'
CompileFlags:
  Add:
    - -IGenerated Files
    - -IShared
    - -Ipackages/Microsoft.Windows.ImplementationLibrary.1.0.260126.7/include

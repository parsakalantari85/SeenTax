<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SeenTax.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeenTax"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SeenTax">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- The tall title bar; MainWindow.xaml.cpp sizes the window from the same 48. -->
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="Toolbar">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
                <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                <x:Double x:Key="TitleBarMinDragRegionWidth">12</x:Double>
            </TitleBar.Resources>

            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="EngineMissingText" Text="Engine not running" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="EngineControls" Orientation="Horizontal" Spacing="8" Opacity="0" IsHitTestVisible="False">
                    <ToggleSwitch x:Name="TrackingSwitch" IsOn="True" IsEnabled="False" OnContent="" OffContent="" MinWidth="0"
                                  ToolTipService.ToolTip="Hand tracking" AutomationProperties.Name="Hand tracking" />
                    <FontIcon Glyph="&#xF42F;" FontSize="16" ToolTipService.ToolTip="Pointer speed" />
                    <Slider x:Name="SpeedSlider" Width="100" Minimum="50" Maximum="200" StepFrequency="10" Value="100" IsEnabled="False"
                            VerticalAlignment="Center" AutomationProperties.Name="Pointer speed" />
                    <TextBlock x:Name="SpeedText" Text="100%" MinWidth="36" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                    <!-- Enabled once the Engine is connected. -->
                    <ToggleButton x:Name="CameraButton" IsEnabled="False" Background="Transparent" BorderThickness="0" Padding="10,8"
                                  ToolTipService.ToolTip="Camera view" AutomationProperties.Name="Camera view">
                        <FontIcon Glyph="&#xE8B8;" FontSize="16" />
                    </ToggleButton>
                    <Button x:Name="SettingsButton" Background="Transparent" BorderThickness="0" Padding="10,8"
                            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                                <StackPanel Width="288" Spacing="12">
                                    <StackPanel.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.MergedDictionaries>
                                                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
                                            </ResourceDictionary.MergedDictionaries>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </ResourceDictionary>
                                    </StackPanel.Resources>

                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Left click" VerticalAlignment="Center" />
                                        <ComboBox x:Name="LeftClickPose" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" />
                                        <TextBlock Grid.Row="1" Text="Right click" VerticalAlignment="Center" />
                                        <ComboBox x:Name="RightClickPose" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" />
                                        <TextBlock Grid.Row="2" Text="Double click" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DoubleClickPose" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" />
                                        <TextBlock Grid.Row="3" Text="Select / move" VerticalAlignment="Center" />
                                        <ComboBox x:Name="HoldPose" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False"
                                                  ToolTipService.ToolTip="Hold to press the button: select text, move or resize windows" />
                                        <TextBlock Grid.Row="4" Text="Scroll" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ScrollPose" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False"
                                                  ToolTipService.ToolTip="Hold the pinch and move your hand up or down to scroll" />

                                        <TextBlock Grid.Row="5" Text="Camera" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CameraChoice" Grid.Row="5" Grid.Column="1" PlaceholderText="Default camera" HorizontalAlignment="Stretch" IsEnabled="False" />

                                        <TextBlock Grid.Row="6" Text="Run on" VerticalAlignment="Center" />
                                        <RadioButtons x:Name="DeviceChoice" Grid.Row="6" Grid.Column="1" MaxColumns="3" SelectedIndex="0" IsEnabled="False"
                                                      ToolTipService.ToolTip="Auto: the graphics card when Windows prefers it (usually while plugged in), otherwise the CPU">
                                            <x:String>Auto</x:String>
                                            <x:String>CPU</x:String>
                                            <x:String>GPU</x:String>
                                        </RadioButtons>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <Button x:Name="RecalibrateButton" Content="Recenter pointer" HorizontalAlignment="Stretch" IsEnabled="False"
                                                ToolTipService.ToolTip="Counts down, then makes where your hand is the middle of the screen" />
                                        <TextBlock x:Name="CalibrationText" TextWrapping="Wrap" Visibility="Collapsed"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>

                                    <TextBlock x:Name="StatusText" Text="Engine not running" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Shown while the camera button is on; the window grows to fit it. -->
        <local:CameraView x:Name="CameraPanel" Grid.Row="1" Visibility="Collapsed" Margin="8,0,8,8" />
    </Grid>
</Window>

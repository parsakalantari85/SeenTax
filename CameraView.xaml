<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SeenTax.CameraView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Border x:Name="Video" Background="Black" Visibility="Collapsed">
            <Viewbox>
                <!-- Sized to the picture in pixels, so the hand's points need no scaling. Mirrored, so the
                     picture moves like a mirror does. -->
                <Grid x:Name="Picture" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Grid.RenderTransform>
                    <Image x:Name="CameraImage" Stretch="Fill" />
                    <Canvas x:Name="Overlay" />
                </Grid>
            </Viewbox>
        </Border>

        <TextBlock x:Name="WaitingText" Text="Waiting for the camera" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border x:Name="ClickFlash" BorderThickness="4" CornerRadius="{StaticResource ControlCornerRadius}" Visibility="Collapsed" />
        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2"
                CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" Foreground="Black" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
        <Border x:Name="DistanceChip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2"
                CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="DistanceText" Foreground="Black" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <Grid x:Name="StatusPanel" VerticalAlignment="Bottom" Padding="8,4,8,7" Background="#99000000" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="PinchText" HorizontalAlignment="Right" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Fills with the pinch value; the marker is where the next pinch starts or ends. -->
        <Grid x:Name="PinchBar" Height="3" VerticalAlignment="Bottom" Opacity="0" Background="#4DFFFFFF">
            <Rectangle x:Name="PinchFill" HorizontalAlignment="Left" Width="0" />
            <Rectangle x:Name="PinchMarker" HorizontalAlignment="Left" Width="2" Fill="White" />
        </Grid>
    </Grid>
</UserControl>
